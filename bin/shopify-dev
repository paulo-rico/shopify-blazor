#!/usr/bin/env bash
#
# shopify-dev — bring up the local Shopify Blazor app stack:
#   1. the Blazor sample app on PORT
#   2. an ngrok tunnel to that port, on the reserved domain in SHOPIFY_APP_URL
#
# For the .NET toolkit, not the Rails app. The Rails one lives at
# ~/aiprojects/shopify-jeweller-workspace/shopify-jewellery-costing/bin/shopify-dev and is
# unchanged; it uses port 3459 now that this app owns 3458.
#
# Unlike the Rails script this one is NOT idempotent about the app: it stops whatever is on
# PORT first, so `bin/shopify-dev` always gives you a freshly built, freshly started app rather
# than silently reusing a stale one. The tunnel is still reused if it is already forwarding to
# the right port, because re-reserving a domain you already hold is slow and pointless.
#
# Services this script starts are stopped again on Ctrl+C. Services that were already running
# (an existing tunnel) are left alone.
set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$APP_DIR"

# systemd and desktop launchers do not read ~/.bashrc, so put the tools this app needs on PATH
# explicitly: ~/.local/bin supplies ngrok, mise supplies nothing here but is harmless.
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

log()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m!!\033[0m %s\n' "$*" >&2; exit 1; }

# ── preconditions ────────────────────────────────────────────────────────────
command -v ngrok >/dev/null || die "ngrok not found (expected at ~/.local/bin/ngrok)."
command -v dotnet >/dev/null || die "dotnet not found. Install the .NET 10 SDK."

# The .NET CLI writes to ~/.dotnet and ~/.nuget. When that is not writable (a sandboxed
# session, a read-only home, CI) the CLI fails before doing anything with a bare
# "Read-only file system", which reads like a build error and is not one. Keeping both inside
# the repository makes the script work anywhere and keeps the SDK's state with the project.
export DOTNET_CLI_HOME="${DOTNET_CLI_HOME:-$APP_DIR/.dotnet}"
export NUGET_PACKAGES="${NUGET_PACKAGES:-$APP_DIR/.nuget/packages}"
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1
mkdir -p "$DOTNET_CLI_HOME" "$NUGET_PACKAGES"

# ── configuration ────────────────────────────────────────────────────────────
# .env is optional: the Shopify credentials may live in user secrets instead, and this script
# only needs PORT and SHOPIFY_APP_URL. Read it without sourcing it, because Shopify secrets are
# not shell-quoted and an unquoted `#` or space would corrupt them.
env_value() {
  local key="$1" file="$APP_DIR/.env"
  [[ -f "$file" ]] || return 0
  sed -nE "s/^${key}=(.*)$/\1/p" "$file" | tail -1 | sed -E 's/^["'\''](.*)["'\'']$/\1/'
}

# Precedence: an exported variable wins, then .env, then the default.
PORT="${PORT:-$(env_value PORT)}"
PORT="${PORT:-3458}"

APP_URL="${SHOPIFY_APP_URL:-$(env_value SHOPIFY_APP_URL)}"
TUNNEL_HOST="$(printf '%s' "$APP_URL" | sed -E 's|^https?://||; s|/.*$||')"

PROJECT="${PROJECT:-samples/Shopify.Blazor.SampleApp}"
ENVIRONMENT="${ASPNETCORE_ENVIRONMENT:-Development}"
PROJECT_FILE="$APP_DIR/$PROJECT/$(basename "$PROJECT").csproj"

[[ "$PORT" =~ ^[0-9]+$ ]] || die "PORT is not a number: '$PORT'"
[[ -f "$PROJECT_FILE" ]] || die "project not found: $PROJECT_FILE"

if [[ -z "$TUNNEL_HOST" ]]; then
  warn "SHOPIFY_APP_URL is not set, so no reserved ngrok domain was given."
  warn "ngrok will assign a random URL and the Admin's App URL will not point at it."
fi

# ── port ownership ───────────────────────────────────────────────────────────
# Docker's published-port forwarder keeps LISTENing on a host port even when nothing inside the
# container is serving it. A container therefore owns the port outright: no host process can bind
# it, and killing processes cannot free it. That is worth detecting precisely, because "address
# already in use" from Kestrel sends people looking for a stray dotnet process that is not there.
port_listeners() { ss -ltnp 2>/dev/null | grep -E ":${1}[[:space:]]" || true; }
port_in_use()    { [[ -n "$(port_listeners "$1")" ]]; }

docker_owner() {
  command -v docker >/dev/null 2>&1 || return 0
  docker ps --filter "publish=$1" --format '{{.Names}} ({{.Image}})' 2>/dev/null | head -1
}

app_responding() {
  # The app serves its shell at / and answers 200 without any Shopify configuration.
  curl -fsS --max-time 5 -o /dev/null "http://127.0.0.1:$1/" 2>/dev/null
}

stop_app_on_port() {
  local port="$1" pids

  pids="$(pgrep -f "Shopify\.Blazor\.SampleApp.*--urls http://[^ ]*:$port" 2>/dev/null || true)"

  if [[ -z "$pids" ]]; then
    # Fall back to anything that looks like this app, so a process started by hand is also stopped.
    pids="$(pgrep -f "dotnet.*Shopify\.Blazor\.SampleApp" 2>/dev/null || true)"
  fi

  if [[ -z "$pids" ]]; then
    return 1
  fi

  log "stopping the app already on port $port (pid ${pids//$'\n'/ })"
  # shellcheck disable=SC2086
  kill $pids 2>/dev/null || true

  for _ in $(seq 1 20); do
    # shellcheck disable=SC2086
    kill -0 $pids 2>/dev/null || return 0
    sleep 0.25
  done

  warn "the app did not stop within 5s; sending SIGKILL"
  # shellcheck disable=SC2086
  kill -9 $pids 2>/dev/null || true
  sleep 1
  return 0
}

# ── cleanup ──────────────────────────────────────────────────────────────────
APP_PID=""
NGROK_PID=""
# ONCE=1 makes the script bring everything up and exit instead of supervising. Used by the
# verification step so the whole thing can be tested without a human pressing Ctrl+C.
ONCE="${ONCE:-0}"

cleanup() {
  local code=$?
  trap - INT TERM EXIT
  echo

  if [[ -n "$APP_PID" ]]; then
    log "stopping the app (pid $APP_PID)"
    # The dotnet host forwards SIGTERM to the app, which lets Blazor shut down cleanly. Give it a
    # moment, then insist: a Kestrel that ignores SIGTERM holds the port and the next run fails.
    kill "$APP_PID" 2>/dev/null || true
    for _ in $(seq 1 20); do
      kill -0 "$APP_PID" 2>/dev/null || break
      sleep 0.25
    done
    kill -9 "$APP_PID" 2>/dev/null || true
  fi

  if [[ -n "$NGROK_PID" ]]; then
    log "stopping ngrok (pid $NGROK_PID)"
    kill "$NGROK_PID" 2>/dev/null || true
  fi

  wait 2>/dev/null || true
  log "stopped."
  exit "$code"
}

# ── 1. free the port ─────────────────────────────────────────────────────────
DOCKER_HOLDER="$(docker_owner "$PORT")"

if [[ -n "$DOCKER_HOLDER" ]]; then
  cat >&2 <<EOF

!! Port $PORT is published by a Docker container: $DOCKER_HOLDER

   Docker's port forwarder owns the port, so no local process can bind it and stopping
   processes cannot help. Nothing inside the container is serving it either, which is why
   the port looks busy while the app answers nothing.

   This is the dev-stack's Rails port. The Blazor app is meant to have $PORT, and the
   dev-stack should publish 3459 instead. To do that:

     cd ~/docker/dev-stack
     \$EDITOR compose.yml          # change  "3458:3458"  to  "3459:3459"
     docker compose up -d          # recreates the ruby container on the new port
     grep -n 3458,\\ 3459 compose.yml   # confirm

   Then set PORT=3459 in the Rails app's .env so that script keeps working, and re-run this.

EOF
  exit 1
fi

if app_responding "$PORT"; then
  stop_app_on_port "$PORT" || true
elif port_in_use "$PORT"; then
  warn "port $PORT is LISTENing but does not answer / — stopping whatever holds it"
  stop_app_on_port "$PORT" || true
  # Something else may hold it: report rather than guessing.
  if port_in_use "$PORT"; then
    die "port $PORT is still in use by another process. Find it with: ss -ltnp | grep :$PORT"
  fi
else
  log "port $PORT is free"
fi

# ── 2. ngrok tunnel ──────────────────────────────────────────────────────────
ngrok_api() { curl -s --max-time 4 http://127.0.0.1:4040/api/tunnels 2>/dev/null; }

if ngrok_api | grep -q '"public_url"'; then
  FORWARDED="$(ngrok_api | grep -oE '"addr":"[^"]+"' | head -1 | sed -E 's/.*:([0-9]+)"/\1/')"
  if [[ "$FORWARDED" == "$PORT" ]]; then
    log "ngrok already tunnelling to port $PORT — reusing it"
  else
    warn "ngrok is running but forwards to port ${FORWARDED:-?}, not $PORT."
    warn "Stop it (or open http://127.0.0.1:4040) and re-run, or set PORT=$FORWARDED."
    exit 1
  fi
else
  if pgrep -x ngrok >/dev/null 2>&1; then
    die "an ngrok process exists but its API is not answering on 127.0.0.1:4040; stop it and retry."
  fi

  if [[ -n "$TUNNEL_HOST" ]]; then
    log "starting ngrok: https://$TUNNEL_HOST -> http://localhost:$PORT"
    ngrok http "$PORT" --url="https://$TUNNEL_HOST" --log=stdout --log-format=logfmt \
      >/tmp/ngrok-shopify-blazor.log 2>&1 &
  else
    log "starting ngrok -> http://localhost:$PORT (no reserved domain)"
    ngrok http "$PORT" --log=stdout --log-format=logfmt \
      >/tmp/ngrok-shopify-blazor.log 2>&1 &
  fi

  NGROK_PID=$!

  for _ in $(seq 1 30); do
    ngrok_api | grep -q '"public_url"' && break
    kill -0 "$NGROK_PID" 2>/dev/null || die "ngrok exited early — see /tmp/ngrok-shopify-blazor.log"
    sleep 1
  done

  ngrok_api | grep -q '"public_url"' || die "ngrok did not come up in 30s — see /tmp/ngrok-shopify-blazor.log"
  log "ngrok tunnel established"
fi

# ── 3. the app ───────────────────────────────────────────────────────────────
# --urls binds the exact port; ASPNETCORE_URLS would be overridden by it, so only one is used.
log "starting $PROJECT on http://localhost:$PORT (ASPNETCORE_ENVIRONMENT=$ENVIRONMENT)"
ASPNETCORE_ENVIRONMENT="$ENVIRONMENT" \
  dotnet run --project "$PROJECT_FILE" --no-launch-profile --urls "http://127.0.0.1:$PORT" \
  >/tmp/shopify-blazor-app.log 2>&1 &
APP_PID=$!

for _ in $(seq 1 90); do
  app_responding "$PORT" && break
  kill -0 "$APP_PID" 2>/dev/null || die "the app exited during startup. See /tmp/shopify-blazor-app.log"
  sleep 1
done

app_responding "$PORT" || die "the app did not answer on port $PORT within 90s. See /tmp/shopify-blazor-app.log"
log "app is up"

# ── 4. readiness + where to go ───────────────────────────────────────────────
PUBLIC="$(ngrok_api | grep -oE '"public_url":"[^"]+"' | head -1 | sed -E 's/.*"public_url":"([^"]+)".*/\1/')"

cat <<EOF

  ─────────────────────────────────────────────────────────────
   Local app           http://localhost:$PORT
   Public app          ${PUBLIC:-https://${TUNNEL_HOST:-<random ngrok url>}}
   Diagnostics         http://localhost:$PORT/api/diagnostics/session-token
   ngrok dashboard     http://127.0.0.1:4040
   App log             /tmp/shopify-blazor-app.log
   ngrok log           /tmp/ngrok-shopify-blazor.log
  ─────────────────────────────────────────────────────────────

  The Shopify Admin loads this app through the public URL, so keep this window
  open. Press Ctrl+C to stop what this script started.

EOF

if [[ "$ONCE" == "1" ]]; then
  log "ONCE=1, so leaving the app and tunnel running and exiting."
  trap - INT TERM EXIT
  exit 0
fi

if [[ -z "$APP_PID" && -z "$NGROK_PID" ]]; then
  log "nothing to supervise."
  exit 0
fi

wait
