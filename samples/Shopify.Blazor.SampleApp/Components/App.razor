@* The single HTML document for the app. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <base href="/" />

    @*
        App Bridge and Polaris, in that order, before anything renders. App Bridge injects the
        `shopify` global from the API key meta tag; Polaris defines the custom elements the whole UI
        is built from. Loading either one lazily gives a page of unstyled, inert elements.
    *@
    <ShopifyAppBridgeHead />

    <title>Shopify Blazor Toolkit — sample app</title>

    @*
        The reconnection dialog's styles. A plain static file rather than a scoped .razor.css, so it
        carries no dependency on the assembly name and works identically in the sample and in a
        generated project.
    *@
    <link rel="stylesheet" href="css/reconnect-modal.css" />

    <HeadOutlet />
</head>
<body>
    <Routes />

    @*
        Reports a lost SignalR circuit. Deliberately static markup: the dialog has to be shown by
        JavaScript when no circuit exists to render anything.
    *@
    <ReconnectModal />

    <script src="_framework/blazor.web.js"></script>
    <script type="module" src="js/reconnect-modal.js"></script>
    <script type="module" src="js/shopify-fetch.js"></script>
</body>
</html>
