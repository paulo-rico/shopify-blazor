@page "/"
@using System.Globalization
@using Shopify.Blazor.AppBridge
@using Shopify.Blazor.SampleApp.Services
@implements IDisposable
@inject IAppBridgeInterop Bridge
@inject ProductCatalogue Catalogue

@*
    The element names this page claims to render, for tools/verify-in-browser.mjs to read — the same
    contract the component gallery has. Only what this page always renders is listed: a chip appears
    when a filter is applied and a spinner while something loads, so listing either would fail the
    check on a page that is working correctly.
*@
<span id="polaris-probe-elements" data-elements="@string.Join(",", ProbedElements)" hidden></span>

<PolarisStack Gap="PolarisGap.Base">
    <PolarisSection Heading="What this sample proves">
        <PolarisStack Gap="PolarisGap.Base">
            <PolarisParagraph>
                This is the reference application for the Shopify Blazor Toolkit. It runs as an
                embedded app inside the Shopify Admin, builds its whole interface from Shopify's own
                Polaris web components, and reaches the Admin API through a server that never lets a
                credential near the browser.
            </PolarisParagraph>

            <PolarisStack Direction="PolarisStackDirection.Inline" Gap="PolarisGap.Base">
                <PolarisBadge Tone="PolarisTone.Success">Polaris components</PolarisBadge>
                <PolarisBadge Tone="PolarisTone.Info">App Bridge 4</PolarisBadge>
                <PolarisBadge Tone="PolarisTone.Neutral">Token exchange</PolarisBadge>
            </PolarisStack>
        </PolarisStack>
    </PolarisSection>

    <PolarisSection Heading="Products data grid (composed)">
        <PolarisStack Gap="PolarisGap.Base">
            <PolarisParagraph>
                Polaris has a table, and nothing that sorts, filters, pages or selects it. These four
                components are composed from what does exist: a sortable heading is an
                <code>s-button</code>, a selected row is an <code>s-checkbox</code> in a cell, the
                filter panel is an <code>s-popover</code> opened declaratively with
                <code>commandFor</code>, and the range control is two native range inputs over one
                track. They are three separate components sharing one state object, which is what makes
                them one grid.
            </PolarisParagraph>

            <PolarisParagraph>
                The rows come from <code>ProductCatalogue</code> — 150 products, loaded asynchronously
                the way the Admin API answers, which is why the grid has a spinner of its own. The data
                is a stand-in for a store's catalogue; the grid is not, and it renders
                <code>/api/products</code> unchanged when the app is opened inside the Admin. Reload
                replaces the collection under the same state, so the page, the filters and the
                selection all survive it.
            </PolarisParagraph>

            <PolarisDataFilter State="_gridState" ApplyMode="PolarisGridFilterApplyMode.Debounced">
                <Actions>
                    <PolarisButton OnClick="ReloadFromButtonAsync" Loading="_gridState.IsLoading">
                        Reload
                    </PolarisButton>
                </Actions>
            </PolarisDataFilter>

            <PolarisDataGrid TItem="SampleProduct"
                             State="_gridState"
                             AllowSelection="true"
                             EmptyHeading="No product matches those filters"
                             EmptySubheading="Clear a filter, or search for something else."
                             SelectionChanged="SelectionChangedAsync">
                <Columns>
                    <PolarisGridColumn TItem="SampleProduct"
                                       Field="product => product.Title"
                                       Title="Product"
                                       ListSlot="PolarisTableListSlot.Primary"
                                       FilterType="PolarisGridFilterType.Text" />

                    <PolarisGridColumn TItem="SampleProduct"
                                       Field="product => product.Status"
                                       Title="Status"
                                       FilterType="PolarisGridFilterType.MultiSelect">
                        <CellTemplate Context="product">
                            <PolarisBadge Tone="@StatusTone(product.Status)">@product.Status</PolarisBadge>
                        </CellTemplate>
                    </PolarisGridColumn>

                    <PolarisGridColumn TItem="SampleProduct"
                                       Field="product => product.ProductType"
                                       Title="Type"
                                       FilterType="PolarisGridFilterType.MultiSelect" />

                    <PolarisGridColumn TItem="SampleProduct"
                                       Field="product => product.Vendor"
                                       Title="Vendor"
                                       FilterType="PolarisGridFilterType.Text" />

                    <PolarisGridColumn TItem="SampleProduct"
                                       Field="product => product.Price"
                                       Title="Price"
                                       Format="C2"
                                       FormatProvider="@UkPounds"
                                       Alignment="PolarisTableHeaderFormat.Currency"
                                       FilterType="PolarisGridFilterType.Range" />

                    <PolarisGridColumn TItem="SampleProduct"
                                       Field="product => product.Inventory"
                                       Title="Inventory"
                                       Alignment="PolarisTableHeaderFormat.Numeric"
                                       FilterType="PolarisGridFilterType.Range" />

                    <PolarisGridColumn TItem="SampleProduct"
                                       Field="product => product.UpdatedAt"
                                       Title="Updated"
                                       FilterType="PolarisGridFilterType.DateRange" />
                </Columns>
            </PolarisDataGrid>

            <PolarisDataPager State="_gridState" PageSizeOptions="@(new[] { 10, 25, 50, 100 })" />

            <PolarisStack Direction="PolarisStackDirection.Inline" Gap="PolarisGap.Small">
                <PolarisText Color="PolarisColor.Subdued">Rows selected:</PolarisText>
                <PolarisBadge Tone="PolarisTone.Info">@_selectedCount</PolarisBadge>
                <PolarisText Color="PolarisColor.Subdued">· sorted by:</PolarisText>
                <PolarisBadge Tone="PolarisTone.Neutral">@_sortSummary</PolarisBadge>
                <PolarisText Color="PolarisColor.Subdued">· loaded:</PolarisText>
                <PolarisBadge Tone="PolarisTone.Neutral">@_loadedSummary</PolarisBadge>
            </PolarisStack>
        </PolarisStack>
    </PolarisSection>

    <PolarisSection Heading="Where it is running">
        <PolarisStack Gap="PolarisGap.Base">
            @if (_checking)
            {
                <PolarisStack Direction="PolarisStackDirection.Inline" Gap="PolarisGap.Base">
                    <PolarisSpinner AccessibilityLabel="Checking the environment" />
                    <PolarisText>Checking the environment…</PolarisText>
                </PolarisStack>
            }
            else if (_embedded == true)
            {
                <PolarisBanner Heading="Embedded in the Shopify Admin"
                               Tone="PolarisTone.Success">
                    App Bridge is available, so session tokens, toasts and Admin navigation all work.
                    Open the Products page to make a real authenticated Admin API call.
                </PolarisBanner>
            }
            else
            {
                <PolarisBanner Heading="Standalone browser session"
                               Tone="PolarisTone.Warning">
                    <PolarisParagraph>
                        App Bridge is loaded from the CDN but only becomes active inside the Admin.
                        Everything you see here is still genuine Polaris: the same custom elements the
                        Admin uses, upgraded by the same script.
                    </PolarisParagraph>
                </PolarisBanner>
            }
        </PolarisStack>
    </PolarisSection>

    <PolarisSection Heading="Try it">
        <PolarisStack Direction="PolarisStackDirection.Inline" Gap="PolarisGap.Base">
            <PolarisButton Variant="PolarisButtonVariant.Primary" Href="/products" Target="PolarisLinkTarget.Self">
                Load products from the Admin API
            </PolarisButton>
            <PolarisButton Href="/components" Target="PolarisLinkTarget.Self" OnClick="ShowToastAsync">
                Show a toast
            </PolarisButton>
        </PolarisStack>
    </PolarisSection>

    <PolarisSection Heading="Accordion (composed)">
        <PolarisStack Gap="PolarisGap.Base">
            <PolarisParagraph>
                Polaris has no accordion element. This one is composed from components that do
                exist — an <code>s-button</code> header, an <code>s-box</code> for the content, an
                <code>s-icon</code> chevron and a <code>div</code> that clips and animates. Open a
                section and the open one closes in the same frame, so both transitions run together.
            </PolarisParagraph>

            <PolarisAccordion OpenItemChanged="SectionChangedAsync">
                <PolarisAccordionItem Value="piece"
                                      Header="Piece details"
                                      HeaderDetails="What the piece is and what was agreed for it."
                                      InitiallyOpen="true">
                    <PolarisStack Gap="PolarisGap.Base">
                        <PolarisTextField Label="Piece name" Value="Victorian signet ring" />
                        <PolarisMoneyField Label="Agreed price" CurrencyCode="GBP" Value="4850.00" />
                        <PolarisSwitch Label="Hallmarked" Details="Metal has been assayed and stamped." Checked="true" />
                    </PolarisStack>
                </PolarisAccordionItem>

                <PolarisAccordionItem Value="stones"
                                      Header="Stones and materials"
                                      HeaderDetails="The ingredients this piece is costed from.">
                    <PolarisTextArea Label="Notes"
                                     Rows="3"
                                     Value="Old European cut diamond, 0.9ct. Shank thin at the base." />
                </PolarisAccordionItem>

                <PolarisAccordionItem Value="notes"
                                      Header="Workshop notes"
                                      HeaderDetails="Anything the bench needs to know.">
                    <PolarisStack Gap="PolarisGap.Base">
                        <PolarisText>
                            This section is closed when you arrive, so its fields are clipped and
                            inert — unreachable by Tab and unannounced by a screen reader.
                        </PolarisText>
                        <PolarisButton OnClick="ShowToastAsync">A button inside a panel</PolarisButton>
                    </PolarisStack>
                </PolarisAccordionItem>
            </PolarisAccordion>

            <PolarisStack Direction="PolarisStackDirection.Inline" Gap="PolarisGap.Small">
                <PolarisText Color="PolarisColor.Subdued">The server believes this section is open:</PolarisText>
                <PolarisBadge Tone="PolarisTone.Info">@(_openSection ?? "none")</PolarisBadge>
            </PolarisStack>

            <PolarisText Color="PolarisColor.Subdued">
                The same component with AllowMultiple: sections are independent, and closing one
                leaves the others alone.
            </PolarisText>

            <PolarisAccordion AllowMultiple="true">
                <PolarisAccordionItem Header="Care instructions" InitiallyOpen="true">
                    <PolarisText>Warm water, soft brush, no ultrasonic cleaner on opals.</PolarisText>
                </PolarisAccordionItem>
                <PolarisAccordionItem Header="Delivery">
                    <PolarisText>Insured special delivery, signature on receipt.</PolarisText>
                </PolarisAccordionItem>
            </PolarisAccordion>
        </PolarisStack>
    </PolarisSection>

    <PolarisSection Heading="Request a fresh session token">
        <PolarisStack Gap="PolarisGap.Base">
            <PolarisText>
                Session tokens are short lived and minted on demand. This calls App Bridge directly.
            </PolarisText>
            <PolarisButton OnClick="MintTokenAsync" Loading="_minting">Mint a session token</PolarisButton>
            @if (_tokenSummary is not null)
            {
                <PolarisBanner Heading="Token minted" Tone="PolarisTone.Info">
                    <PolarisText>@_tokenSummary</PolarisText>
                </PolarisBanner>
            }
        </PolarisStack>
    </PolarisSection>
</PolarisStack>

@code {
    /// <summary>Sterling is priced in pounds, and a cost column formatted with the invariant culture reads as $.</summary>
    private static readonly CultureInfo UkPounds = CultureInfo.GetCultureInfo("en-GB");

    private PolarisGridState<SampleProduct> _gridState = null!;

    /// <summary>
    /// Every element this page renders unconditionally, and therefore the list the browser
    /// verification checks.
    /// </summary>
    /// <remarks>
    /// The grid's elements are most of the list, and they are the interesting half: a table that has
    /// not upgraded renders as an empty box, and a checkbox that has not upgraded looks ticked while
    /// nothing is selected.
    /// </remarks>
    private static readonly string[] ProbedElements =
    [
        // The shell, from the layout.
        "s-page", "s-stack", "s-divider", "s-button",

        // The accordion's own composition, plus the fields inside it.
        "s-section", "s-paragraph", "s-badge", "s-banner", "s-text", "s-text-field", "s-money-field",
        "s-switch", "s-text-area", "s-clickable", "s-box", "s-icon",

        // The data grid, its filter and its pager. The filter's controls are in the DOM whether the
        // panel is open or not, which is what lets them be verified here.
        "s-search-field", "s-popover", "s-select", "s-option", "s-number-field", "s-checkbox",
        "s-choice-list", "s-choice", "s-date-field",
        "s-table", "s-table-header-row", "s-table-header", "s-table-body", "s-table-row", "s-table-cell",
    ];

    private bool _checking = true;
    private bool _minting;
    private bool? _embedded;
    private string? _openSection;
    private string? _tokenSummary;
    private int _selectedCount;
    private string? _loadedSummary;

    /// <summary>What the grid is ordered by, read from the shared state rather than tracked separately.</summary>
    private string _sortSummary => _gridState.Query.Sorts.Count == 0
        ? "source order"
        : string.Join(", ", _gridState.Query.Sorts.Select(sort => $"{sort.Field} {sort.Direction}"));

    /// <summary>
    /// Creates the one state the filter, the grid and the pager share. The page owns it, which is why
    /// it is disposed here and by nothing else.
    /// </summary>
    /// <remarks>
    /// The state starts empty and is filled by <see cref="ReloadAsync"/>, because the catalogue answers
    /// asynchronously. That ordering is what makes the grid's own loading state visible: the page does
    /// not draw a spinner beside a table, the grid draws it instead of the table.
    /// </remarks>
    protected override void OnInitialized()
    {
        _gridState = new PolarisGridState<SampleProduct>(keySelector: product => product.Id);
        _gridState.SetPageSize(10);

        // The page shows the state's own summary — what it is sorted by, how many rows are selected —
        // so it has to redraw when the grid changes the state as well. The components subscribe for
        // themselves; a page that renders part of the same story has to do the same.
        _gridState.Changed += OnGridStateChanged;
    }

    /// <inheritdoc />
    protected override Task OnInitializedAsync() => ReloadAsync();

    /// <summary>
    /// Replaces the catalogue from the data source.
    /// </summary>
    /// <remarks>
    /// Deliberately a replacement, not a rebuild: the state, the page, the filters and the selection all
    /// survive it. That is the difference between "reload the data" and "reload the screen", and it is
    /// the behaviour a real screen needs when the pricing job has just run.
    /// </remarks>
    private async Task ReloadAsync()
    {
        _gridState.SetError(null);
        _gridState.SetLoading(true);

        try
        {
            var rows = await Catalogue.LoadAsync();

            _gridState.SetItems(rows);
            _loadedSummary = string.Create(
                CultureInfo.InvariantCulture,
                $"{rows.Count} products at {DateTime.Now:HH:mm:ss}");
        }
        catch (Exception ex)
        {
            // The grid renders this in place of the rows, so a failed load never looks like an empty
            // catalogue — which is the one thing a merchant would act on wrongly.
            _gridState.SetError(ex.Message);
        }
        finally
        {
            _gridState.SetLoading(false);
        }
    }

    private Task ReloadFromButtonAsync(PolarisEventArgs args) => ReloadAsync();

    /// <summary>
    /// The badge colour for a product status, matching the Products page.
    /// </summary>
    /// <remarks>
    /// The status is spelled out inside the badge as well as coloured: tone is not announced, so three
    /// tone-only badges would read identically to a screen reader.
    /// </remarks>
    private static PolarisTone StatusTone(string status) => status.ToUpperInvariant() switch
    {
        "ACTIVE" => PolarisTone.Success,
        "DRAFT" => PolarisTone.Warning,
        "ARCHIVED" => PolarisTone.Neutral,
        _ => PolarisTone.Info,
    };

    private void OnGridStateChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// The grid reports what is selected by key: the records themselves are the page's, and a list of
    /// them would go stale the moment the collection was replaced.
    /// </summary>
    private Task SelectionChangedAsync(IReadOnlyCollection<object> keys)
    {
        _selectedCount = keys.Count;
        return Task.CompletedTask;
    }

    /// <summary>Detaches from the shared state and stops it notifying a renderer that no longer exists.</summary>
    public void Dispose()
    {
        _gridState.Changed -= OnGridStateChanged;
        _gridState.Dispose();
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _embedded = await Bridge.IsAvailableAsync();
        _checking = false;
        StateHasChanged();
    }

    private async Task ShowToastAsync(PolarisEventArgs args)
    {
        await Bridge.ShowToastAsync("Hello from the Shopify Blazor Toolkit.");
    }

    /// <summary>
    /// The accordion reports which section is open, which is how anything outside it can follow the
    /// merchant's choice. A closing section reports null.
    /// </summary>
    private void SectionChangedAsync(string? value) => _openSection = value;

    private async Task MintTokenAsync(PolarisEventArgs args)
    {
        _minting = true;

        try
        {
            var token = await Bridge.WithLoadingAsync(() => Bridge.GetIdTokenAsync().AsTask());

            _tokenSummary = token is null
                ? "App Bridge could not mint a token here; open the app from inside the Admin."
                : $"A JWT was issued and handed straight to the server on the next request. " +
                  $"This page only ever sees the token, never an Admin API access token. " +
                  $"Length: {token.Length} characters.";
        }
        finally
        {
            _minting = false;
        }
    }
}
