@page "/"
@using Shopify.Blazor.AppBridge
@inject IAppBridgeInterop Bridge

<PolarisStack Gap="PolarisGap.Base">
    <PolarisSection Heading="What this sample proves">
        <PolarisStack Gap="PolarisGap.Base">
            <PolarisParagraph>
                This is the reference application for the Shopify Blazor Toolkit. It runs as an
                embedded app inside the Shopify Admin, builds its whole interface from Shopify's own
                Polaris web components, and reaches the Admin API through a server that never lets a
                credential near the browser.
            </PolarisParagraph>

            <PolarisStack Direction="PolarisStackDirection.Inline" Gap="PolarisGap.Base">
                <PolarisBadge Tone="PolarisTone.Success">Polaris components</PolarisBadge>
                <PolarisBadge Tone="PolarisTone.Info">App Bridge 4</PolarisBadge>
                <PolarisBadge Tone="PolarisTone.Neutral">Token exchange</PolarisBadge>
            </PolarisStack>
        </PolarisStack>
    </PolarisSection>

    <PolarisSection Heading="Where it is running">
        <PolarisStack Gap="PolarisGap.Base">
            @if (_checking)
            {
                <PolarisStack Direction="PolarisStackDirection.Inline" Gap="PolarisGap.Base">
                    <PolarisSpinner AccessibilityLabel="Checking the environment" />
                    <PolarisText>Checking the environment…</PolarisText>
                </PolarisStack>
            }
            else if (_embedded == true)
            {
                <PolarisBanner Heading="Embedded in the Shopify Admin"
                               Tone="PolarisTone.Success">
                    App Bridge is available, so session tokens, toasts and Admin navigation all work.
                    Open the Products page to make a real authenticated Admin API call.
                </PolarisBanner>
            }
            else
            {
                <PolarisBanner Heading="Standalone browser session"
                               Tone="PolarisTone.Warning">
                    <PolarisParagraph>
                        App Bridge is loaded from the CDN but only becomes active inside the Admin.
                        Everything you see here is still genuine Polaris: the same custom elements the
                        Admin uses, upgraded by the same script.
                    </PolarisParagraph>
                </PolarisBanner>
            }
        </PolarisStack>
    </PolarisSection>

    <PolarisSection Heading="Try it">
        <PolarisStack Direction="PolarisStackDirection.Inline" Gap="PolarisGap.Base">
            <PolarisButton Variant="PolarisButtonVariant.Primary" Href="/products" Target="PolarisLinkTarget.Self">
                Load products from the Admin API
            </PolarisButton>
            <PolarisButton Href="/components" Target="PolarisLinkTarget.Self" OnClick="ShowToastAsync">
                Show a toast
            </PolarisButton>
        </PolarisStack>
    </PolarisSection>

    <PolarisSection Heading="Accordion (composed)">
        <PolarisStack Gap="PolarisGap.Base">
            <PolarisParagraph>
                Polaris has no accordion element. This one is composed from components that do
                exist — an <code>s-button</code> header, an <code>s-box</code> for the content, an
                <code>s-icon</code> chevron and a <code>div</code> that clips and animates. Open a
                section and the open one closes in the same frame, so both transitions run together.
            </PolarisParagraph>

            <PolarisAccordion OpenItemChanged="SectionChangedAsync">
                <PolarisAccordionItem Value="piece" Header="Piece details" InitiallyOpen="true">
                    <PolarisStack Gap="PolarisGap.Base">
                        <PolarisTextField Label="Piece name" Value="Victorian signet ring" />
                        <PolarisMoneyField Label="Agreed price" CurrencyCode="GBP" Value="4850.00" />
                        <PolarisSwitch Label="Hallmarked" Details="Metal has been assayed and stamped." Checked="true" />
                    </PolarisStack>
                </PolarisAccordionItem>

                <PolarisAccordionItem Value="stones" Header="Stones and materials">
                    <PolarisTextArea Label="Notes"
                                     Rows="3"
                                     Value="Old European cut diamond, 0.9ct. Shank thin at the base." />
                </PolarisAccordionItem>

                <PolarisAccordionItem Value="notes" Header="Workshop notes">
                    <PolarisStack Gap="PolarisGap.Base">
                        <PolarisText>
                            This section is closed when you arrive, so its fields are clipped and
                            inert — unreachable by Tab and unannounced by a screen reader.
                        </PolarisText>
                        <PolarisButton OnClick="ShowToastAsync">A button inside a panel</PolarisButton>
                    </PolarisStack>
                </PolarisAccordionItem>
            </PolarisAccordion>

            <PolarisStack Direction="PolarisStackDirection.Inline" Gap="PolarisGap.Small">
                <PolarisText Color="PolarisColor.Subdued">The server believes this section is open:</PolarisText>
                <PolarisBadge Tone="PolarisTone.Info">@(_openSection ?? "none")</PolarisBadge>
            </PolarisStack>

            <PolarisText Color="PolarisColor.Subdued">
                The same component with AllowMultiple: sections are independent, and closing one
                leaves the others alone.
            </PolarisText>

            <PolarisAccordion AllowMultiple="true">
                <PolarisAccordionItem Header="Care instructions" InitiallyOpen="true">
                    <PolarisText>Warm water, soft brush, no ultrasonic cleaner on opals.</PolarisText>
                </PolarisAccordionItem>
                <PolarisAccordionItem Header="Delivery">
                    <PolarisText>Insured special delivery, signature on receipt.</PolarisText>
                </PolarisAccordionItem>
            </PolarisAccordion>
        </PolarisStack>
    </PolarisSection>

    <PolarisSection Heading="Request a fresh session token">
        <PolarisStack Gap="PolarisGap.Base">
            <PolarisText>
                Session tokens are short lived and minted on demand. This calls App Bridge directly.
            </PolarisText>
            <PolarisButton OnClick="MintTokenAsync" Loading="_minting">Mint a session token</PolarisButton>
            @if (_tokenSummary is not null)
            {
                <PolarisBanner Heading="Token minted" Tone="PolarisTone.Info">
                    <PolarisText>@_tokenSummary</PolarisText>
                </PolarisBanner>
            }
        </PolarisStack>
    </PolarisSection>
</PolarisStack>

@code {
    private bool _checking = true;
    private bool _minting;
    private bool? _embedded;
    private string? _openSection;
    private string? _tokenSummary;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _embedded = await Bridge.IsAvailableAsync();
        _checking = false;
        StateHasChanged();
    }

    private async Task ShowToastAsync(PolarisEventArgs args)
    {
        await Bridge.ShowToastAsync("Hello from the Shopify Blazor Toolkit.");
    }

    /// <summary>
    /// The accordion reports which section is open, which is how anything outside it can follow the
    /// merchant's choice. A closing section reports null.
    /// </summary>
    private void SectionChangedAsync(string? value) => _openSection = value;

    private async Task MintTokenAsync(PolarisEventArgs args)
    {
        _minting = true;

        try
        {
            var token = await Bridge.WithLoadingAsync(() => Bridge.GetIdTokenAsync().AsTask());

            _tokenSummary = token is null
                ? "App Bridge could not mint a token here; open the app from inside the Admin."
                : $"A JWT was issued and handed straight to the server on the next request. " +
                  $"This page only ever sees the token, never an Admin API access token. " +
                  $"Length: {token.Length} characters.";
        }
        finally
        {
            _minting = false;
        }
    }
}
