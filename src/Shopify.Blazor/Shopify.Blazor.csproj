<!--
  Microsoft.NET.Sdk.Razor, not Microsoft.NET.Sdk: this package ships app-bridge.js as a static web
  asset, and only the Razor SDK produces the manifest that publishes it at
  /_content/Shopify.Blazor/. With a plain SDK project the package builds, the file is absent from
  the .nupkg, and every App Bridge call fails at runtime — the same silent failure that
  Polaris.Blazor hit.
-->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>Shopify.Blazor</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>Shopify application infrastructure for Blazor: embedded-app authentication, App Bridge interop and authenticated Admin API access.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
  </ItemGroup>

</Project>
