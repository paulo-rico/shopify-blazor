@page "/Error"

<PolarisPage Heading="Something went wrong">
    <PolarisSection>
        <PolarisBanner Heading="The request could not be completed" Tone="PolarisTone.Critical">
            <PolarisText Paragraph="true">
                Check the server log for the exception. In production this page deliberately shows no
                detail, and it never shows a stack trace.
            </PolarisText>
        </PolarisBanner>
    </PolarisSection>
</PolarisPage>
