<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Shopify.Blazor.SampleApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!--
      A per-project secrets id, so `dotnet user-secrets set` works on the first command. The
      template engine generates a fresh GUID per project rather than sharing one, because
      user-secrets stores are keyed by this id and a shared one would mix two apps' credentials.
    -->
    <UserSecretsId>SHOPIFY_BLAZOR_USER_SECRETS_ID</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The toolkit. Polaris.Blazor is the component library; Shopify.Blazor is the embedded-app
      infrastructure (App Bridge, session-token validation, token exchange, Admin API client).
      They are separate on purpose: a UI-only app can reference Polaris.Blazor alone.
    -->
    <PackageReference Include="Polaris.Blazor" Version="TOOLKIT_PACKAGE_VERSION" />
    <PackageReference Include="Shopify.Blazor" Version="TOOLKIT_PACKAGE_VERSION" />
  </ItemGroup>

</Project>
