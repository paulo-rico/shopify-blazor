# Local development configuration for the Blazor sample app.
#
# Copy to .env (which is git-ignored) and fill in. Everything here can also be supplied as real
# environment variables, which take precedence — see docs/getting-started.md, because an
# environment variable silently overriding these is a common cause of "wrong app" 401s.
#
# bin/shopify-dev reads PORT and SHOPIFY_APP_URL from this file. The Shopify credentials are read
# by the app itself; user secrets are a better home for them:
#   dotnet user-secrets set "Shopify:ApiKey"    "<client id>"     --project samples/Shopify.Blazor.SampleApp
#   dotnet user-secrets set "Shopify:ApiSecret" "<client secret>" --project samples/Shopify.Blazor.SampleApp

# The port the app listens on, and the port the ngrok tunnel must forward to.
PORT=3458

# Which tunnel bin/shopify-dev starts: ngrok (default) or cloudflare.
#
# ngrok's free plan shows a one-off browser-warning page the first time a browser visits the
# endpoint. Click "Visit Site" once and it stops — the Admin's iframe uses the same browser, so it
# stops there too. It answers with HTTP 200 and an HTML body, so scripted callers should send
# ngrok-skip-browser-warning: true; the app's own calls already do.
#
# cloudflare injects nothing at all, but cloudflared has not yet held a connection to Cloudflare's
# edge from this machine — see the note in bin/shopify-dev before switching.
TUNNEL=ngrok

# The public HTTPS URL Shopify loads the app from.
#
# For ngrok this is your reserved domain. For a Cloudflare NAMED tunnel it is the hostname you
# routed to it in the dashboard, and the token goes in .cloudflared-token (git-ignored) or
# CLOUDFLARE_TUNNEL_TOKEN. Without a token the script falls back to a quick tunnel, whose random
# *.trycloudflare.com URL it prints instead.
SHOPIFY_APP_URL=

# Optional: only needed if you do not put the credentials in user secrets.
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
