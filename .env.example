# Local development configuration for the Blazor sample app.
#
# Copy to .env (which is git-ignored) and fill in. Everything here can also be supplied as real
# environment variables, which take precedence — see docs/getting-started.md, because an
# environment variable silently overriding these is a common cause of "wrong app" 401s.
#
# bin/shopify-publish reads only SHOPIFY_APP_URL from this file, to print the URLs a deployment has
# to match. The Shopify credentials are read by the app itself; user secrets are a better home for
# them:
#   dotnet user-secrets set "Shopify:ApiKey"    "<client id>"     --project samples/Shopify.Blazor.SampleApp
#   dotnet user-secrets set "Shopify:ApiSecret" "<client secret>" --project samples/Shopify.Blazor.SampleApp

# The port a local `dotnet run` listens on. The deployed app uses whatever the server configures.
PORT=3458

# The public HTTPS URL your server serves the app from — the address Shopify loads it at. It must
# match the App URL in the Partner Dashboard. Only needed when you run the app locally against a
# deployed Shopify app; the server sets its own.
SHOPIFY_APP_URL=

# Optional: only needed if you do not put the credentials in user secrets.
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
